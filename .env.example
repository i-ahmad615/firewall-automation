# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Email settings are provider-agnostic. The examples below use Microsoft 365 /
# Outlook. To use another provider, change only the host/port/TLS values here.

# ── Sophos SFOS firewall ──────────────────────────────────────────────────────
FIREWALL_HOST=
FIREWALL_PORT=4444
FIREWALL_USERNAME=
FIREWALL_PASSWORD=

# Exact name of the firewall rule to update (must match SFOS exactly)
FIREWALL_RULE_NAME=Block IP

# How often (seconds) to ping the firewall API to check connectivity, shown
# as the status pill in the dashboard topbar. Independent of IMAP_POLL_INTERVAL
# since connectivity health is checked on its own schedule.
FIREWALL_PING_INTERVAL=60

# ── Email / IMAP (inbound alert polling) ──────────────────────────────────────
# Microsoft 365 / Outlook example:
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_USE_STARTTLS=false
IMAP_MAILBOX=INBOX
IMAP_TIMEOUT=30

# Account used to read the mailbox (service account or shared mailbox access)
EMAIL_USERNAME=
EMAIL_PASSWORD=

# ── SMTP (outbound notifications) ─────────────────────────────────────────────
# Microsoft 365 / Outlook example (STARTTLS on port 587):
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# On-premise / implicit SSL example (port 465):
# SMTP_HOST=webmail.company.com
# SMTP_PORT=465
# SMTP_USE_TLS=false
# SMTP_USE_SSL=true
SMTP_TIMEOUT=30

# Optional: separate SMTP credentials (defaults to EMAIL_USERNAME / EMAIL_PASSWORD)
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Optional: From address for notifications (defaults to EMAIL_USERNAME)
# Use a shared mailbox address if IT configured send-as permissions.
# SMTP_FROM=

# Single notification recipient (shared mailbox or distribution list).
# IT mail rules forward this to the security team — do not list individuals here.
NOTIFICATION_EMAIL=

# ── Alert filtering ───────────────────────────────────────────────────────────
TRUSTED_SENDER=
ALERT_KEYWORDS=attack

# ── Allowed IPs ───────────────────────────────────────────────────────────────
ALLOWED_IPS_FILE=config/allowed_ips.txt

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_DIRECTORY=logs/
LOG_LEVEL=INFO

# ── Polling ───────────────────────────────────────────────────────────────────
IMAP_POLL_INTERVAL=60
IMAP_RUN_LOOP=true

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_PATH=data/app.db

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
DASHBOARD_AUTO_OPEN_BROWSER=true
DASHBOARD_ADMIN_USERNAME=admin
# Set a strong password to protect the dashboard. Leave blank to disable login
# (not recommended outside a trusted local machine).
DASHBOARD_ADMIN_PASSWORD=
